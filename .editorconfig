# Настройки редактора для этого репозитория: CLion, VS Code (с расширением
# EditorConfig), Visual Studio и многие другие сохраняют файлы по ним сами.
# Главное — кодировка UTF-8: в Windows-1251 русский текст ломается в автотестах.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
